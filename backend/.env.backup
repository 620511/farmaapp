# ============================================
# BANCO DE DADOS (Supabase)
# ============================================
# Cole aqui as duas strings que você pegou em:
# Supabase > Project Settings > Database > Connection string
#
# DATABASE_URL = modo "Transaction" (porta 6543) — usada pela API no dia a dia
# DIRECT_URL   = modo "Session"/direto (porta 5432) — usada só pelo Prisma nas migrations
#
# Troque [YOUR-PASSWORD] pela senha do banco (a que você resetou).
DATABASE_URL=postgresql://postgres.gozrtayzfhegnalteavg:farmaapp2512@aws-0-sa-east-1.pooler.supabase.com:6543/postgres&pgbouncer=true
DIRECT_URL=postgresql://postgres.gozrtayzfhegnalteavg:farmaapp2512@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ============================================
# SEGURANÇA
# ============================================
# Gere um valor forte com: openssl rand -hex 32
# (ou peça pra mim gerar um aqui na conversa)
JWT_SECRET="1101baed55c36eafe91e97a1e7d69a5c5d90ca53dd09c075ecea37564e153dfc"

PORT=4000
NODE_ENV=development

# ============================================
# CORS / URLS
# ============================================
# Em dev local, deixe como está. Em produção, coloque a URL da Vercel.
ALLOWED_ORIGINS="http://localhost:5173"
BACKEND_PUBLIC_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:5173"

# ============================================
# IA (Anthropic) — leitura de receitas e chat da Bia
# ============================================
# Pegue em: console.anthropic.com > API Keys
ANTHROPIC_API_KEY="coloque_sua_chave_aqui"

# ============================================
# PAGAMENTO (Mercado Pago)
# ============================================
# Pegue em: mercadopago.com.br/developers > suas integrações
MP_ACCESS_TOKEN="coloque_seu_token_aqui"
MP_WEBHOOK_URL=""
MP_WEBHOOK_SECRET=""

# ============================================
# STORAGE DE IMAGENS (Supabase Storage)
# ============================================
# Pegue em: Supabase > Project Settings > Storage > S3 Connection
S3_BUCKET="uploads"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=6b96acf223a59c440c3e3047ab5e3dd0
S3_SECRET_ACCESS_KEY=0589fe0eb3da793753eae9fb8a1418794dd842022dfb606de5b211f96d5d7d16
S3_ENDPOINT="https://SEU_PROJETO.supabase.co/storage/v1/s3"
S3_PUBLIC_URL_BASE="https://SEU_PROJETO.supabase.co/storage/v1/object/public/uploads"

# ============================================
# E-MAIL (opcional — sem isso, só não manda notificação por e-mail)
# ============================================
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Farma.APP <no-reply@farma.app>"

# ============================================
# MONITORAMENTO (opcional)
# ============================================
SENTRY_DSN=""