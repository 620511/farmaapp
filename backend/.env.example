# Banco de dados: Supabase (PostgreSQL), mesmo padrão usado no PetDelivery-CE.
# No painel do Supabase: Project Settings → Database → Connection string.
# DATABASE_URL = conexão via pooler (porta 6543, com pgbouncer=true) — usada em runtime pela API.
# DIRECT_URL   = conexão direta (porta 5432) — usada só pelo Prisma para rodar migrations.
DATABASE_URL="postgresql://postgres.<ref-do-projeto>:<sua-senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref-do-projeto>:<sua-senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"

# Gere um valor forte com: openssl rand -hex 32
JWT_SECRET="troque_por_um_valor_aleatorio_forte"

PORT=4000
NODE_ENV=development

# URL(s) do frontend liberadas no CORS, separadas por vírgula
ALLOWED_ORIGINS="http://localhost:5173"

# URL pública do próprio backend (usada para montar o link das imagens enviadas quando NÃO usa S3/Supabase Storage)
BACKEND_PUBLIC_URL="http://localhost:4000"

# URL do frontend (usada nos links de retorno do checkout do Mercado Pago)
FRONTEND_URL="http://localhost:5173"

# Chave da API da Anthropic (console.anthropic.com) — leitura de receitas com IA
ANTHROPIC_API_KEY="sua_chave_anthropic"

# Credenciais do Mercado Pago (mercadopago.com.br/developers)
MP_ACCESS_TOKEN="seu_access_token_mercado_pago"
MP_WEBHOOK_URL="https://sua-api-publica.com/api/payments/webhook"
MP_WEBHOOK_SECRET=""

# Storage de imagens: Supabase Storage (compatível com S3), mesmo padrão do
# PetDelivery-CE — bucket "uploads" público. Em Project Settings → Storage →
# S3 Connection você encontra o endpoint e pode gerar as chaves de acesso.
S3_BUCKET="uploads"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT="https://<ref-do-projeto>.supabase.co/storage/v1/s3"
S3_PUBLIC_URL_BASE="https://<ref-do-projeto>.supabase.co/storage/v1/object/public/uploads"

# E-mail transacional (opcional). Sem isso, notificações por e-mail são só
# ignoradas silenciosamente — o app funciona normalmente sem elas.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Farma.APP <no-reply@farma.app>"

# Monitoramento de erros (opcional) — sentry.io
SENTRY_DSN=""
